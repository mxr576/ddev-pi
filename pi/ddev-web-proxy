#!/usr/bin/env bash
#ddev-generated
#
# ddev-web-proxy
#
# Forwards tool execution from the PI container to the DDEV web container
# over SSH. This provides transparent access to the web container's PHP runtime,
# Composer, Drush, Yarn, npm, and testing tools for both interactive and non-interactive
# contexts (such as Makefile recipes, scripts, and subshells).

tool="$(basename "$0")"

# If invoked directly as ddev-web-proxy, take the tool name from the first argument.
if [ "$tool" = "ddev-web-proxy" ]; then
  if [ $# -eq 0 ]; then
    echo "Usage: ddev-web-proxy <command> [args...]" >&2
    exit 1
  fi
  tool="$1"
  shift
fi

# Rewrite vendor/bin tools to canonical vendor/bin/<tool> if present in the project.
case "$tool" in
  drush|phpunit|phpstan|phpcs|phpcbf|behat)
    if [ -f "vendor/bin/$tool" ]; then
      cmd="vendor/bin/$tool"
    else
      cmd="$tool"
    fi
    ;;
  *)
    cmd="$tool"
    ;;
esac

# Safely escape arguments for the remote shell.
for arg in "$@"; do
  cmd="${cmd} $(printf "%q" "$arg")"
done

# Load baseline container environment from PID 1 so only variables added or
# modified in the caller session/command are forwarded to the web container.
declare -A init_env=()
if [ -r /proc/1/environ ]; then
  while IFS= read -r -d '' entry; do
    if [[ "$entry" == *"="* ]]; then
      var_name="${entry%%=*}"
      if [[ "$var_name" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
        init_env["$var_name"]="${entry#*=}"
      fi
    fi
  done < /proc/1/environ
fi

# Capture and forward caller environment variables that differ from PID 1.
forwarded_env=""
while IFS= read -r -d '' entry; do
  if [[ "$entry" == *"="* ]]; then
    var_name="${entry%%=*}"
    var_val="${entry#*=}"

    # Validate that variable name is a legal POSIX shell identifier.
    if [[ ! "$var_name" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
      continue
    fi

    # Never forward system, shell, or container-internal variables.
    case "$var_name" in
      HOME|USER|LOGNAME|USERNAME|USER_HOME|UID|GID|PATH|SHELL|TERM|COLORTERM|LS_COLORS|PWD|OLDPWD|SHLVL|_|AI_AGENT|HOSTNAME|DISPLAY|DEBIAN_FRONTEND|NPM_CONFIG_PREFIX|NPM_CONFIG_CACHE|SSH_*|PI_*|DDEV_*)
        continue
        ;;
    esac

    if [[ -z "${init_env[$var_name]+_}" || "${init_env[$var_name]}" != "$var_val" ]]; then
      forwarded_env="${forwarded_env}export $(printf "%s=%q" "$var_name" "$var_val"); "
    fi
  fi
done < <(env -0)

# Allocate pseudo-terminal if connected to an interactive TTY.
ssh_opts=("-o" "ConnectTimeout=5" "-o" "ConnectionAttempts=10")
if [ -t 0 ] && [ -t 1 ]; then
  ssh_opts+=("-t")
fi

escaped_pwd=$(printf "%q" "$PWD")

# Execute inside the web container:
# 1. Export environment variables from /proc/1/environ so non-login shells inherit Docker web_environment.
# 2. Export forwarded caller environment variables, overriding container defaults.
# 3. Match the current working directory if it exists inside the web container, otherwise fallback to /var/www/html.
# 4. Run the command with exit status preserved.
exec ssh "${ssh_opts[@]}" web "export \$(cat /proc/1/environ 2>/dev/null | tr '\\0' '\\n' | grep -E '^[a-zA-Z_][a-zA-Z0-9_]*=' | xargs -d '\\n') 2>/dev/null; ${forwarded_env}cd $escaped_pwd 2>/dev/null || cd /var/www/html; $cmd"
